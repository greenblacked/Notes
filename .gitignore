# Obsidian: share only the vault settings that are safe and useful (app/appearance/
# core-plugins/hotkeys); drop per-device UI state, caches, and community plugin data
# (plugin data.json can hold tokens/API keys).
content/.obsidian/workspace.json
content/.obsidian/workspace-mobile.json
content/.obsidian/workspaces.json
content/.obsidian/cache
content/.obsidian/plugins/
content/.obsidian/themes/
content/.trash/
