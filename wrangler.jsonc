{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves everything. Static site is served from ./public (the Quartz build output)
  // through worker/index.js, which adds security headers, serves /robots.txt and sets cache policy.
  //   - production: `wrangler deploy` from release tags (Cut release) at https://notes.szolotov.com
  //   - stage: a Worker Preview named `stage` (`wrangler preview`, deployed on every merge to
  //     `main`) at https://stage.notes.szolotov.com, public and noindex. See
  //     docs/deployment.md#stage-preview.
  "name": "notes",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // The workers.dev URLs stay on although the site is served from the custom domain: CI verifies
  // every deploy through them, because Cloudflare Bot Fight Mode answers GitHub-hosted runners
  // with 403 on the custom domains. They are never indexable (worker/indexing.js).
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    // previews_enabled serves production AND Previews: the Preview `stage` is then reachable at
    // stage.notes.szolotov.com through a Cloudflare-managed wildcard. Applied by `wrangler deploy`
    // (or the dashboard), not by `wrangler preview`.
    { "pattern": "notes.szolotov.com", "custom_domain": true, "previews_enabled": true },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs for every request so headers are applied to assets and 404s alike.
    "run_worker_first": true,
    // Quartz emits foo.html and links to /foo; folders are foo/index.html linked as /foo/.
    "html_handling": "auto-trailing-slash",
    // Quartz emits 404.html; serve it (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",
  },
  "vars": { "ENVIRONMENT": "production" },
  // Preview settings are not inherited from the top level.
  "previews": {
    "vars": { "ENVIRONMENT": "preview" },
  },
}
